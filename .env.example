# ---------------------------------------------------------------------------
# CloneCinema — variables de entorno
# Copia este archivo a `.env`. Cada módulo avisa en la UI si le falta config.
# ---------------------------------------------------------------------------

# IA de texto (chat director, análisis viral, narración TTS). No consume créditos.
GEMINI_API_KEY="TU_CLAVE_DE_GEMINI"

# URL pública de la app (redirect de Wompi, enlaces de medios locales).
APP_URL="http://localhost:3000"

# --- Supabase: cuentas, saldo, transacciones y Storage ---------------------
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."   # secreta: solo en el servidor

# --- Kaggle: cómputo GPU de imágenes y video -------------------------------
KAGGLE_USERNAME="tu_usuario"
KAGGLE_KEY="tu_api_key"                     # kaggle.com -> Settings -> API -> Create New Token
KAGGLE_FLUX_KERNEL="tu_usuario/clonecinema-flux"
KAGGLE_VIDEO_KERNEL="tu_usuario/clonecinema-wan-i2v"
# Wan 2.1 no tiene I2V de 1.3B: el 14B 480p es el checkpoint real más pequeño.
# WAN_MODEL_ID="Wan-AI/Wan2.1-I2V-14B-480P-Diffusers"
# WAN_NUM_FRAMES="81"
# WAN_FPS="16"
# KAGGLE_JOB_TIMEOUT_MS="2700000"
# HF_TOKEN="hf_..."                        # como secreto de Kaggle si el modelo lo pide

# --- Wompi: pagos en COP (Nequi, PSE, Bancolombia, tarjetas) ---------------
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_INTEGRITY_SECRET="prod_integrity_..."
WOMPI_EVENTS_SECRET="prod_events_..."
WOMPI_BASE_URL="https://checkout.wompi.co"
WOMPI_API_BASE_URL="https://sandbox.wompi.co/v1"

# --- Créditos ---------------------------------------------------------------
CREDIT_COST_IMAGE="1"
CREDIT_COST_VIDEO="5"
# Sin Supabase, permite generar sin cobrar (estudio local). Pon "false" en producción.
ALLOW_ANONYMOUS_GENERATION="true"
